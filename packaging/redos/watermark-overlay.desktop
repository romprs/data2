[Desktop Entry]
Type=Application
Name=Screen Watermark
Comment=Overlays the logged-in user's name across the screen (anti-leak watermark)
Exec=/usr/bin/watermark-overlay
Icon=security-high
NoDisplay=true
Terminal=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=0
X-KDE-autostart-phase=1
Categories=System;
